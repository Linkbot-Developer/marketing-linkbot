# Copy this file to .env and fill in real values. Never commit .env. Never put real secrets here.
# Variable list follows docs/marketing-system-spec.md.

TIMEZONE=Asia/Singapore

# --- Lark (international) ---
LARK_DOMAIN=https://open.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_APP_TOKEN=
LARK_TABLE_CONTENT_ID=
LARK_TABLE_SETTINGS_ID=
LARK_TABLE_REPORTS_ID=
LARK_TABLE_LEADS_ID=
LARK_BRAND_BRIEF_DOC_ID=
LARK_APPROVER_OPEN_ID=        # Lark open_id of marketing@linkbot.sg
LARK_ALERT_CHAT_ID=
LARK_CARD_VERIFICATION_TOKEN=
LARK_CARD_ENCRYPT_KEY=

# --- Text AI (writing, checks, reports): gemini (free tier, for now) or claude ---
AI_TEXT_PROVIDER=gemini
GEMINI_TEXT_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Images ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=

# --- Storage: Lark Drive (folder tokens in docs/lark-workspace.md) ---
LARK_DRIVE_SOCIAL_FOLDER=     # Marketing/Social Media folder token
MEDIA_LINK_SECRET=            # random 32+ byte secret for signing /media/<token> links

# --- Renderer service (DigitalOcean droplet) ---
RENDERER_URL=                 # local: http://localhost:8787 · on the droplet: http://127.0.0.1:8787 (n8n uses https://renderer.linkbot.sg)
RENDERER_API_KEY=
RENDERER_HOST=                # on the droplet: 127.0.0.1 (set by deploy/ecosystem.config.cjs)

# --- n8n ---
N8N_BASE_URL=            # e.g. https://yourname.app.n8n.cloud
N8N_API_KEY=             # n8n: Settings > n8n API > Create an API key
N8N_WEBHOOK_SECRET=

# --- Meta (Facebook Page + Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Optional / later ---
# HIGGSFIELD_API_KEY=
# HEYGEN_API_KEY=
# CREATOMATE_API_KEY=
# GITHUB_TOKEN=
