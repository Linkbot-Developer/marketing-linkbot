{
  "name": "[Marketing] W2 - Daily generation",
  "nodes": [
    {
      "id": "01-every-day-17-00-sgt",
      "name": "Every day 17:00 SGT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "02-start-generation-on-the-server",
      "name": "Start generation on the server",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://renderer.linkbot.sg/jobs/daily",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "d5fDddBnMYJjOU3N",
          "name": "[Marketing] Renderer API key"
        }
      }
    },
    {
      "id": "03-check-the-reply",
      "name": "Check the reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst r = $input.first().json;\n// 202 = started; 409 = a run is already going (fine). Anything else is an error, so W11 alerts the group.\nif (r.statusCode === 202 || r.statusCode === 409) return [{ json: { ok: true, status: r.statusCode, job: r.body } }];\nthrow new Error('The server did not start the daily generation (HTTP ' + r.statusCode + '): ' + JSON.stringify(r.body ?? '').slice(0, 300));"
      }
    }
  ],
  "connections": {
    "Every day 17:00 SGT": {
      "main": [
        [
          {
            "node": "Start generation on the server",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start generation on the server": {
      "main": [
        [
          {
            "node": "Check the reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Singapore",
    "saveManualExecutions": true,
    "errorWorkflow": "<W11 id>"
  }
}