        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "XG0w1tH8E3yi3hwH",
          "name": "[Marketing] Lark app (tenant token)"
        }
      }
    },
    {
      "id": "07-read-settings",
      "name": "Read settings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Lark token').first().json.tenant_access_token }}"
            }
          ]
        },
        "options": {},
        "method": "POST",
        "url": "https://open.larksuite.com/open-apis/bitable/v1/apps/UnVYbyvm2anu0dsmiQ1lGpcsgRh/tables/tbl1qgo2zdmi4cfY/records/search?page_size=100",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      }
    },
    {
      "id": "08-get-the-post",
      "name": "Get the post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Lark token').first().json.tenant_access_token }}"
            }
          ]
        },
        "options": {},
        "method": "GET",
        "url": "=https://open.larksuite.com/open-apis/bitable/v1/apps/UnVYbyvm2anu0dsmiQ1lGpcsgRh/tables/tblBUzCMudCo8xPZ/records/{{ $('Read the click').first().json.record_id }}"
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "09-check-and-decide",
      "name": "Check and decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        450
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst flat = (v) => Array.isArray(v) ? v.map((s) => s.text ?? s).join('') : v;\nconst settings = {};\nfor (const r of $('Read settings').first().json.data.items ?? []) {\n  const raw = String(flat(r.fields.value) ?? '');\n  try { settings[flat(r.fields.setting)] = JSON.parse(raw); } catch { settings[flat(r.fields.setting)] = raw; }\n}\nconst click = $('Read the click').first().json;\nconst rec = $('Get the post').first().json.data?.record;\nconst f = rec?.fields ?? {};\nconst who = settings.approver ?? {};\nconst reason = String(click.reason ?? '').trim();\nconst fail = (msg) => [{ json: { ok: false, message_id: click.message_id, text: msg } }];\nif (!who.open_id || click.operator !== who.open_id) return fail('Only the marketing approver (' + (who.email ?? 'see Settings') + ') can approve or reject posts.');\nif (!rec) return fail('Post not found in Lark Base.');\nif (flat(f.card_message_id) && click.message_id && flat(f.card_message_id) !== click.message_id) return fail('This card is out of date: a newer version was sent.');\nif (flat(f.status) !== 'pending_approval') return fail('Already handled (status: ' + flat(f.status) + ').');\nif (click.action === 'reject' && !reason) return fail('Please type what should change, then press Reject.');\n\nconst now = new Date().toLocaleString('en-GB', { timeZone: 'Asia/Singapore', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });\nconst map = {\n  approve: { fields: { status: 'approved' }, colour: 'green', title: 'Approved', note: 'Approved on ' + now + '. It will be scheduled for its posting time.' },\n  reject: { fields: { status: 'rejected', rejection_reason: reason }, colour: 'red', title: 'Rejected', note: 'Rejected on ' + now + '. A new version will be written with your feedback.' },\n  regenerate: { fields: { status: 'rejected', rejection_reason: reason || 'Regenerate requested: write a clearly different version.' }, colour: 'orange', title: 'Regenerating', note: 'Sent back on ' + now + ' for a new version.' },\n}[click.action];\nif (!map) return fail('Unknown action.');\nconst card = {\n  schema: '2.0', config: { update_multi: true },\n  header: { template: map.colour, title: { tag: 'plain_text', content: map.title + ': ' + flat(f.post_id) }, subtitle: { tag: 'plain_text', content: [flat(f.platform), flat(f.format)].filter(Boolean).join(' · ') } },\n  body: { elements: [\n    { tag: 'markdown', content: map.note + (reason ? '\\n\\n**Your feedback:** ' + reason : '') },\n    { tag: 'markdown', content: '[Open in Lark Base](https://sglinkbot.sg.larksuite.com/base/UnVYbyvm2anu0dsmiQ1lGpcsgRh?table=tblBUzCMudCo8xPZ)' },\n  ] },\n};\nreturn [{ json: { ok: true, record_id: rec.record_id, fields: map.fields, message_id: click.message_id, card: JSON.stringify(card) } }];"
      }
    },
    {
