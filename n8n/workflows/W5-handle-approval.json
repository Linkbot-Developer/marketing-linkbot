{
  "name": "[Marketing] W5 - Handle approval",
  "nodes": [
    {
      "id": "01-lark-card-click",
      "name": "Lark card click",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "marketing-lark-card-<N8N_WEBHOOK_SECRET>",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "02-read-the-click",
      "name": "Read the click",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst b = $input.first().json.body ?? {};\nif (b.type === 'url_verification' || (b.challenge && !b.event)) return [{ json: { kind: 'challenge', challenge: b.challenge } }];\nconst e = b.event ?? {};\nlet v = e.action?.value ?? {};\nif (typeof v === 'string') { try { v = JSON.parse(v); } catch { v = {}; } }\nreturn [{ json: { kind: 'click', action: v.action, record_id: v.record_id, post_id: v.post_id,\n  reason: e.action?.form_value?.reason ?? '', operator: e.operator?.open_id ?? '', message_id: e.context?.open_message_id ?? '' } }];"
      }
    },
    {
      "id": "03-is-lark-checking-the-url-",
      "name": "Is Lark checking the URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "Is Lark checking the URL?-c",
              "leftValue": "={{ $json.kind === 'challenge' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "04-answer-the-url-check",
      "name": "Answer the URL check",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ challenge: $json.challenge }) }}",
        "options": {}
      }
    },
    {
      "id": "05-acknowledge-the-click",
      "name": "Acknowledge the click",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
