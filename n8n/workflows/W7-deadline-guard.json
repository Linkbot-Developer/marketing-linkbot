        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ receive_id: $('Find overdue posts').item.json.chat, msg_type: 'text', content: JSON.stringify({ text: $('Find overdue posts').item.json.text }) }) }}"
      }
    }
