              "value": "=Bearer {{ $('Lark token').first().json.tenant_access_token }}"
            }
          ]
        },
        "options": {},
        "method": "PUT",
        "url": "=https://open.larksuite.com/open-apis/bitable/v1/apps/UnVYbyvm2anu0dsmiQ1lGpcsgRh/tables/tblBUzCMudCo8xPZ/records/{{ $json.record_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { status: \"skipped\", error: $json.error } }) }}"
      }
    },
    {
      "id": "07-grey-out-the-card",
      "name": "Grey out the card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
