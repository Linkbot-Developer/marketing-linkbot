{
  "name": "linkbot-runner",
  "private": true,
  "type": "module",
  "description": "Runs the AI agents on posts from Lark Base: write, brand-check, render, visual QC, write back for approval",
  "scripts": {
    "run": "tsx src/cli.ts",
    "daily": "tsx src/cli.ts --daily",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
